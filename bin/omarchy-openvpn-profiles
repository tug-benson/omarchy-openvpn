#!/usr/bin/env python3
# omarchy-openvpn-profiles
# List NetworkManager OpenVPN connections as JSON: [{"name":..., "path":<uuid>}, ...]
# Runs as the user; no root required.
#
# Only OpenVPN connections are listed. nmcli exposes the VPN service type per
# connection, so each vpn connection is queried once. Other NetworkManager VPN
# types (fortisslvpn, openconnect, l2tp, ...) cannot be managed by this plugin --
# it writes OpenVPN-only vpn.data keys -- so they are filtered out.
import subprocess, json

OPENVPN_SERVICE = "org.freedesktop.NetworkManager.openvpn"


def nmcli(*args):
    return subprocess.run(["nmcli", *args], capture_output=True, text=True).stdout


def is_openvpn(uuid):
    out = nmcli("-t", "-f", "vpn.service-type", "connection", "show", uuid)
    return out.strip().split(":", 1)[-1].strip() == OPENVPN_SERVICE


profiles = []
for line in nmcli("-t", "-f", "NAME,UUID,TYPE", "connection", "show").splitlines():
    parts = line.split(":")
    if len(parts) >= 3 and parts[2] == "vpn" and is_openvpn(parts[1]):
        profiles.append({"name": parts[0], "path": parts[1]})

print(json.dumps(profiles))
