#!/usr/bin/env python3
# omarchy-openvpn-profiles
# List NetworkManager VPN connections as JSON: [{"name":..., "path":<uuid>}, ...]
# Runs as the user; no root required.
import subprocess, json

out = subprocess.run(
    ["nmcli", "-t", "-f", "NAME,UUID,TYPE", "connection", "show"],
    capture_output=True, text=True,
).stdout

profiles = []
for line in out.splitlines():
    parts = line.split(":")
    if len(parts) >= 3 and parts[2] == "vpn":
        profiles.append({"name": parts[0], "path": parts[1]})

print(json.dumps(profiles))
