#!/bin/bash

# Script pour appliquer les informations de connexion et gérer le TOTP
if [ $# -lt 2 ]; then
    echo "Usage: $0 <login> <password>"
    exit 1
fi

LOGIN="$1"
PASSWORD="$2"

# Vérifier si le fichier de configuration existe
if [ ! -f "/etc/openvpn/client.conf" ]; then
    echo "Le fichier de configuration OpenVPN n'existe pas."
    exit 1
fi

# Appliquer les informations de connexion
echo "auth-user-pass" | sudo tee -a /etc/openvpn/client.conf > /dev/null
echo "$LOGIN" | sudo tee -a /etc/openvpn/client.conf > /dev/null
echo "$PASSWORD" | sudo tee -a /etc/openvpn/client.conf > /dev/null

# Vérifier si le TOTP est requis (via une variable d'environnement ou un fichier de configuration)
TOTP_REQUIRED=$(grep -c "auth-token" /etc/openvpn/client.conf)

if [ "$TOTP_REQUIRED" -gt 0 ]; then
    echo "TOTP requis pour la connexion VPN"
else
    echo "Informations de connexion appliquées."
fi
