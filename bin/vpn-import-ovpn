#!/bin/bash

# Script pour importer un fichier .ovpn OpenVPN
# Usage: vpn-import-ovpn <fichier_ovpn>

if [ $# -ne 1 ]; then
    echo "Usage: $0 <fichier.ovpn>"
    exit 1
fi

OVPN_FILE="$1"

if [ ! -f "$OVPN_FILE" ]; then
    echo "Fichier introuvable: $OVPN_FILE"
    exit 1
fi

# Copier le fichier vers le répertoire de configuration OpenVPN
CONF_DIR="/etc/openvpn/client"
CONF_DEST="$CONF_DIR/$(basename "$OVPN_FILE")"

# Créer le répertoire s'il n'existe pas
mkdir -p "$CONF_DIR"

# Copier le fichier
cp "$OVPN_FILE" "$CONF_DEST"

# Appliquer les DNS si configurés dans le fichier
# Extraire les directives DNS du fichier .ovpn
DNS_IP=$(grep -m1 "^dhcp-option DNS" "$OVPN_FILE" | awk '{print $2}')
DOMAIN=$(grep -m1 "^dhcp-option DOMAIN" "$OVPN_FILE" | awk '{$1=""; print substr($0,2)}' | head -1)

if [ -n "$DNS_IP" ]; then
    sudo resolvectl dns tun0 "$DNS_IP" 2>/dev/null || true
fi
if [ -n "$DOMAIN" ]; then
    sudo resolvectl domain tun0 "$DOMAIN" 2>/dev/null || true
fi

# Essayer de restart le VPN avec la nouvelle configuration
sudo systemctl restart openvpn-client@client 2>/dev/null || true

echo "Fichier .ovpn importé avec succès: $CONF_DEST"